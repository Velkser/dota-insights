{"sql":"SELECT m.match_id, m.start_time, m.duration, m.radiant_win, m.radiant_gold_adv, ARRAY(SELECT concat_ws(':', o->>'time', CASE WHEN o->>'type' = 'CHAT_MESSAGE_ROSHAN_KILL' THEN 'roshan:' || (o->>'team') WHEN o->>'type' = 'CHAT_MESSAGE_MINIBOSS_KILL' THEN 'tormentor:' || (o->>'team') WHEN o->>'key' LIKE '%tower%' THEN 'tower:' || CASE WHEN o->>'key' LIKE '%goodguys%' THEN '3' ELSE '2' END WHEN o->>'key' LIKE '%rax%' THEN 'barracks:' || CASE WHEN o->>'key' LIKE '%goodguys%' THEN '3' ELSE '2' END END) FROM unnest(m.objectives) o WHERE o->>'type' IN ('CHAT_MESSAGE_ROSHAN_KILL', 'CHAT_MESSAGE_MINIBOSS_KILL') OR (o->>'type' = 'building_kill' AND (o->>'key' LIKE '%tower%' OR o->>'key' LIKE '%rax%'))) AS events FROM matches m WHERE m.match_id IN (SELECT p.match_id FROM player_matches p JOIN matches m USING (match_id) JOIN match_patch mp USING (match_id) WHERE p.hero_id = 11 AND mp.patch = '7.41' AND m.radiant_gold_adv IS NOT NULL ORDER BY p.match_id DESC LIMIT 60)","rows":[{"match_id":8994110105,"start_time":1789158705,"duration":1841,"radiant_win":false,"radiant_gold_adv":[-77,-898,-1450,-1920,-1992,-2074,-2550,-2385,-3229,-4448,-5152,-5015,-5873,-4841,-4907,-3639,-3487,-5556,-5042,-5207,-6976,-7921,-8325,-8979,-11428,-12539,-12406,-13745,-15708,-18558,-19105],"events":["585:tower:3","879:tower:2","907:tower:3","967:tower:3","1054:tower:2","1279:tormentor:3","1390:tower:3","1553:roshan:3","1631:tower:3","1681:tower:3","1695:barracks:3","1700:barracks:3","1776:tower:3","1827:tower:3","1839:barracks:3","1840:barracks:3"]},{"match_id":9010354923,"start_time":1790024975,"duration":2034,"radiant_win":false,"radiant_gold_adv":[0,152,-125,-459,-896,-542,-496,-1295,-1322,-1988,-2264,-4210,-4335,-4691,-6191,-7179,-7053,-8416,-8936,-9856,-9734,-9665,-9894,-8652,-9024,-12616,-13161,-12824,-13102,-13961,-15617,-15624,-17627,-20053],"events":["430:tower:2","585:tower:2","600:tower:3","893:tower:3","1046:roshan:3","1164:tower:3","1242:tormentor:3","1262:tower:3","1389:tower:3","16