DOTA_INSIGHTS_HOST=127.0.0.1
DOTA_INSIGHTS_PORT=8000
DOTA_INSIGHTS_OPENDOTA_API_KEY=
DOTA_INSIGHTS_STRATZ_API_TOKEN=
DOTA_INSIGHTS_DATABASE_URL=postgresql://localhost:5432/dota_insights
# Collector budgets (defaults leave ~1,200 of OpenDota's 3,000/day for live tool calls)
# DOTA_INSIGHTS_COLLECTOR_OPENDOTA_DAILY_BUDGET=1800
# DOTA_INSIGHTS_COLLECTOR_STRATZ_DAILY_BUDGET=5000
# DOTA_INSIGHTS_COLLECTOR_STRATZ_HOURLY_BUDGET=1000
# Shared state across instances (Upstash Redis REST; Vercel injects these with the integration)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Per-client limits on tool calls
# DOTA_INSIGHTS_RATE_LIMIT_ENABLED=true
# DOTA_INSIGHTS_RATE_LIMIT_PER_MINUTE=30
# DOTA_INSIGHTS_RATE_LIMIT_HEAVY_PER_MINUTE=5
# Telegram alerts on quota exhaustion and error-rate spikes
# DOTA_INSIGHTS_TELEGRAM_BOT_TOKEN=
# DOTA_INSIGHTS_TELEGRAM_CHAT_ID=
